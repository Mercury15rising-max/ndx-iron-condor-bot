# Local IBKR diagnostic only. Never put usernames/passwords in this file.
# Enter your PAPER account ID locally; this is not your paper username.
IBKR_MODE=paper
IBKR_EXPECTED_PAPER_ACCOUNT=DU_REPLACE_LOCALLY
IBKR_HOST=127.0.0.1
# TWS paper default is 7497. IB Gateway paper default is 4002.
IBKR_PORT=7497
IBKR_CLIENT_ID=71
IBKR_TIMEOUT_SECONDS=15
